# Supabase PostgreSQL connection string (Direct connection on port 5432 or Pooler on port 6543)
# Example: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# Supabase API Credentials
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Frontend Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://[PROJECT-REF].supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_API_URL=http://localhost:8000

# Shopify & Security Configuration
APP_ENV=production
JWT_SECRET=change-me-32-chars-min
ENCRYPTION_KEY=
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-01
SHOPIFY_CLIENT_SECRET=

# India Post Courier Integration Credentials
INDIA_POST_ENABLED=true
INDIA_POST_API_BASE_URL=https://api.indiapost.gov.in/v1
INDIA_POST_CLIENT_ID=your-india-post-client-id
INDIA_POST_CLIENT_SECRET=your-india-post-client-secret
INDIA_POST_API_KEY=your-india-post-api-key

# DTDC Courier Integration Credentials
DTDC_ENABLED=true
DTDC_API_BASE_URL=https://api.dtdc.com/v1
DTDC_CLIENT_ID=your-dtdc-client-id
DTDC_CLIENT_SECRET=your-dtdc-client-secret
DTDC_API_KEY=your-dtdc-api-key
DTDC_ACCOUNT_CODE=your-dtdc-account-code
DTDC_CUSTOMER_CODE=your-dtdc-customer-code

